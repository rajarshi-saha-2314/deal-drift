# Copy this file to `.env` and fill in your actual Railway MySQL credentials.
# Never commit the real `.env` file.

# Railway MySQL connection (from your Railway project's "Connect" tab / MYSQL_* variables)
MYSQL_HOST=your-railway-mysql-host.proxy.rlwy.net
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=railway

# Optional: connection timeout (seconds) used by config/db_config.py
MYSQL_CONNECT_TIMEOUT=10
